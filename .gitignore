# Data and intermediates. Everything here is regenerated by the pipeline.
# The small result tables are committed so the links in the README resolve on
# GitHub and a reviewer can audit the numbers without a 15 GB download.
# FastQC zips and MultiQC's data directory are 175 MB and stay out.
results/*
!results/stats/
!results/counts/
!results/metadata/
!results/summary.md
!results/qc/
results/qc/*
!results/qc/read_retention.tsv
!results/qc/multiqc_report.html

resources/
logs/
.snakemake/

# The generated report is committed so the repo is readable without a run.
!report/report.pdf

# Local environments
.venv/
.Rlib/

# OS and editor noise
.DS_Store
*.swp
__pycache__/
.pytest_cache/
build/
